# Connect to the SAME MySQL server used by your other services.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=shared_app
MYSQL_USER=payment_app
MYSQL_PASSWORD=change-me

# mock completes transactions for local demos. Use momo only with sandbox credentials.
PAYMENT_GATEWAY=mock
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment-result
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
